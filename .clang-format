# mib's C style: 4-space indents, function braces on their own line, 100 columns.
# Run `make format` to apply it and `make format-check` to verify it.
BasedOnStyle: LLVM
IndentWidth: 4
BreakBeforeBraces: Linux
ColumnLimit: 100
# Include order can matter (Windows headers), so leave it as written.
SortIncludes: Never
