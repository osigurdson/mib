# Cross-compile on Linux using Zig's bundled mingw-w64 headers/libraries.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
get_filename_component(JOT_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(CMAKE_C_COMPILER "${JOT_ROOT}/tools/zig-windows-cc.sh")
set(CMAKE_RC_COMPILER "" CACHE FILEPATH "No resource compiler required")
find_program(JOT_WINE wine)
if(JOT_WINE)
    set(CMAKE_CROSSCOMPILING_EMULATOR "${JOT_WINE}" CACHE STRING "Run Windows tests under Wine")
endif()
